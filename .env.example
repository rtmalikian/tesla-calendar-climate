# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — your secrets never leave your machine.

# --- Tesla Fleet API credentials ---------------------------------------
# Register a developer application at https://developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Fleet API region: na (North America), eu (Europe), cn (China)
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback
# Where OAuth tokens are stored locally (file is created with mode 600)
TESLA_TOKEN_FILE=~/.tcc/tokens.json

# --- Your vehicles -------------------------------------------------------
# Format: name=VIN, one entry per car, comma-separated.
TCC_VEHICLES=Daily=5YJ3E1EA0KF000001,Second=7SAYGDEE5PF000002

# --- Calendar ------------------------------------------------------------
# Your calendar's secret iCal URL.
# Google Calendar: Settings -> your calendar -> "Secret address in iCal format"
TCC_CALENDAR_ICS_URL=

# --- Home location -------------------------------------------------------
# Preconditioning only runs when the car is parked at home.
# Find your coordinates: right-click your house in Google Maps.
TCC_HOME_LAT=
TCC_HOME_LON=
# How close (meters) counts as "home"
TCC_HOME_RADIUS_M=200

# --- Climate behavior ----------------------------------------------------
# Cabin target temperature in °C
TCC_TARGET_TEMP_C=21
# How far ahead of an event to start preconditioning (minutes)
TCC_LEAD_MINUTES=20
# Longer lead time on very hot / very cold days
TCC_HOT_LEAD_MINUTES=30
TCC_COLD_LEAD_MINUTES=30
TCC_HOT_THRESHOLD_C=30
TCC_COLD_THRESHOLD_C=5
# How far ahead to look for events (hours)
TCC_LOOKAHEAD_HOURS=12
# Stop preconditioning this many minutes after the event start
TCC_OVERRUN_MINUTES=10

# --- Cabin Overheat Protection -------------------------------------------
# Re-arm COP before Tesla's ~12h auto-cutoff during long hot parks,
# and turn COP on if you left it off on a hot day.
TCC_COP_REARM=true
TCC_COP_MAX_PARK_HOURS=11

# --- Runtime ---------------------------------------------------------------
TCC_STATE_FILE=~/.tcc/calendar_climate_state.json
TCC_POLL_INTERVAL_SECONDS=300
# Dry run: log what WOULD happen without sending any commands.
TCC_DRY_RUN=false
